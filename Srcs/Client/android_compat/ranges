struct identity {
    template <typename T>
    constexpr T&& operator()(T&& t) const noexcept {
        return std::forward<T>(t);
    }
};

struct less {
    template <typename T, typename U>
    constexpr bool operator()(T&& t, U&& u) const {
        return std::forward<T>(t) < std::forward<U>(u);
    }
};

struct greater {
    template <typename T, typename U>
    constexpr bool operator()(T&& t, U&& u) const {
        return std::forward<T>(t) > std::forward<U>(u);
    }
};

struct equal_to {
    template <typename T, typename U>
    constexpr bool operator()(T&& t, U&& u) const {
        return std::forward<T>(t) == std::forward<U>(u);
    }
};

using std::begin;
using std::end;
using std::rbegin;
using std::rend;
using std::size;
using std::empty;

template <typename It>
constexpr auto distance(It first, It last) -> decltype(std::distance(first, last)) {
    return std::distance(first, last);
}

template <typename R>
constexpr auto distance(R&& r) -> decltype(std::distance(std::begin(r), std::end(r))) {
    return std::distance(std::begin(r), std::end(r));
}

template <typename R, typename T, typename Proj = identity>
auto find(R&& r, const T& value, Proj proj = {}) {
    auto first = std::begin(r);
    auto last = std::end(r);
    for (; first != last; ++first) {
        if (std::invoke(proj, *first) == value)
            return first;
    }
    return last;
}

template <typename R, typename Pred, typename Proj = identity>
auto find_if(R&& r, Pred pred, Proj proj = {}) {
    auto first = std::begin(r);
    auto last = std::end(r);
    for (; first != last; ++first) {
        if (std::invoke(pred, std::invoke(proj, *first)))
            return first;
    }
    return last;
}

template <typename R, typename Pred, typename Proj = identity>
auto find_if_not(R&& r, Pred pred, Proj proj = {}) {
    auto first = std::begin(r);
    auto last = std::end(r);
    for (; first != last; ++first) {
        if (!std::invoke(pred, std::invoke(proj, *first)))
            return first;
    }
    return last;
}

template <typename R, typename Pred, typename Proj = identity>
bool any_of(R&& r, Pred pred, Proj proj = {}) {
    return ranges::find_if(std::forward<R>(r), std::move(pred), std::move(proj)) != std::end(r);
}

template <typename R, typename Pred, typename Proj = identity>
bool all_of(R&& r, Pred pred, Proj proj = {}) {
    return ranges::find_if_not(std::forward<R>(r), std::move(pred), std::move(proj)) == std::end(r);
}

template <typename R, typename Pred, typename Proj = identity>
bool none_of(R&& r, Pred pred, Proj proj = {}) {
    return !ranges::any_of(std::forward<R>(r), std::move(pred), std::move(proj));
}

template <typename R, typename Fun, typename Proj = identity>
Fun for_each(R&& r, Fun f, Proj proj = {}) {
    for (auto&& elem : r) {
        std::invoke(f, std::invoke(proj, elem));
    }
    return f;
}

template <typename R, typename T, typename Proj = identity>
auto count(R&& r, const T& value, Proj proj = {}) {
    typename std::iterator_traits<decltype(std::begin(r))>::difference_type ret = 0;
    for (auto&& elem : r) {
        if (std::invoke(proj, elem) == value)
            ++ret;
    }
    return ret;
}

template <typename R, typename Pred, typename Proj = identity>
auto count_if(R&& r, Pred pred, Proj proj = {}) {
    typename std::iterator_traits<decltype(std::begin(r))>::difference_type ret = 0;
    for (auto&& elem : r) {
        if (std::invoke(pred, std::invoke(proj, elem)))
            ++ret;
    }
    return ret;
}

template <typename R, typename Comp = less, typename Proj = identity>
void sort(R&& r, Comp comp = {}, Proj proj = {}) {
    std::sort(std::begin(r), std::end(r), [&](auto&& a, auto&& b) {
        return std::invoke(comp, std::invoke(proj, a), std::invoke(proj, b));
    });
}

template <typename R, typename OutIter>
OutIter copy(R&& r, OutIter out) {
    return std::copy(std::begin(r), std::end(r), out);
}

template <typename R, typename OutIter, typename Pred, typename Proj = identity>
OutIter copy_if(R&& r, OutIter out, Pred pred, Proj proj = {}) {
    for (auto&& elem : r) {
        if (std::invoke(pred, std::invoke(proj, elem))) {
            *out++ = elem;
        }
    }
    return out;
}

template <typename R, typename T>
void fill(R&& r, const T& value) {
    std::fill(std::begin(r), std::end(r), value);
}

template <typename R, typename OutIter, typename Op, typename Proj = identity>
OutIter transform(R&& r, OutIter out, Op op, Proj proj = {}) {
    for (auto&& elem : r) {
        *out++ = std::invoke(op, std::invoke(proj, elem));
    }
    return out;
}

template <typename R, typename Comp = less, typename Proj = identity>
auto min_element(R&& r, Comp comp = {}, Proj proj = {}) {
    return std::min_element(std::begin(r), std::end(r), [&](auto&& a, auto&& b) {
        return std::invoke(comp, std::invoke(proj, a), std::invoke(proj, b));
    });
}

template <typename R, typename Comp = less, typename Proj = identity>
auto max_element(R&& r, Comp comp = {}, Proj proj = {}) {
    return std::max_element(std::begin(r), std::end(r), [&](auto&& a, auto&& b) {
        return std::invoke(comp, std::invoke(proj, a), std::invoke(proj, b));
    });
}

